// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  workouts  Workout[]
  records   PersonalRecord[]
}

model Exercise {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?  // e.g. "push", "pull", "legs", "cardio", "climbing"
  createdAt DateTime @default(now())

  sets      Set[]
  records   PersonalRecord[]
}

model Workout {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  sets      Set[]
}

model Set {
  id          String    @id @default(cuid())
  workoutId   String
  workout     Workout   @relation(fields: [workoutId], references: [id])
  exerciseId  String
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])

  weight      Float?
  reps        Int?
  rpe         Float?
  duration    Int?
  distance    Float?

  createdAt   DateTime  @default(now())
}

enum RecordType {
  MAX_WEIGHT      // heaviest weight for N reps (e.g. 1RM, 5RM)
  MAX_REPS        // most reps at a given weight
  BEST_TIME       // fastest time for a distance (running)
  MAX_DISTANCE    // farthest distance in a duration
  MAX_GRADE       // climbing grade (e.g. V6, 5.12a)
}

model PersonalRecord {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])

  exerciseId  String?
  exercise    Exercise?   @relation(fields: [exerciseId], references: [id])

  type        RecordType

  value       Float       // the record value itself: lbs, seconds, miles, or grade-as-number
  reps        Int?        // relevant for MAX_WEIGHT / MAX_REPS (e.g. "5" in "5RM")
  distance    Float?      // relevant for BEST_TIME (e.g. 2.0 for a 2-mile PR)
  gradeLabel  String?     // relevant for MAX_GRADE (e.g. "V6", "5.12a") since grades aren't purely numeric

  achievedAt  DateTime    @default(now())
  sourceSetId String?     // optional: link back to the Set that produced this PR
  notes       String?

  createdAt   DateTime    @default(now())
}
